// Saarthi canonical data model (PostgreSQL + Prisma).
// See docs/DATABASE_ARCHITECTURE.md for the rationale behind every table.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum WellnessDomain {
  SKIN
  PHYSICAL
  MENTAL
  COMBINED
}

enum AnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  /// Cancelled by the owner before completion. Terminal.
  CANCELLED
}

/// Which product feature made an AI provider call (cost/latency accounting).
enum AiFeature {
  COMBINED_SYNTHESIS
  COMPANION
  JOURNAL_SUMMARY
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

/// Sex used ONLY for published energy equations that require it. Optional; never inferred.
enum SexForCalculation {
  FEMALE
  MALE
}

/// How a report's numbers were produced. Never infer a stronger method than this.
enum ReportMethod {
  /// Computed by the Saarthi CV service from the user's own uploaded image.
  COMPUTER_VISION
  /// Deterministic formula over the user's questionnaire answers.
  QUESTIONNAIRE_RULES
  /// Narrative synthesis produced by a language model over stored reports.
  LLM_SYNTHESIS
  /// Created before Phase 1; provenance cannot be verified (may include LLM-fabricated scores).
  LEGACY_UNVERIFIED
}

enum StorageProvider {
  CLOUDINARY
}

enum AssetPurpose {
  SKIN_SCAN
  PHYSICAL_SCAN
}

enum AssetStatus {
  ACTIVE
  DELETED
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  HEALTH_DATA_PROCESSING
  IMAGE_PROCESSING
  AI_PROCESSING
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RecommendationStatus {
  ACTIVE
  COMPLETED
  DISMISSED
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id        String   @id @default(cuid())
  /// Clerk subject. The only externally-supplied identifier we trust, and only from a verified session.
  clerkId   String   @unique
  email     String?
  name      String?
  imageUrl  String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile          UserProfile?
  preferences      UserPreferences?
  consents         ConsentRecord[]
  assets           UploadedAsset[]
  analyses         Analysis[]
  skinReports      SkinReport[]
  physicalReports  PhysicalReport[]
  mentalReports    MentalWellnessReport[]
  wellnessReports  CombinedWellnessReport[]
  progressHistory  ProgressHistory[]
  achievements     Achievement[]
  dailyHabits      DailyHabit[]
  journalEntries   JournalEntry[]
  recommendations  Recommendation[]
  conversations    AIConversation[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  goals            WellnessGoal[]
  aiUsage          AiUsageEvent[]
}

model UserProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Legacy free-form fields (pre-Phase-2). Not used by calculations.
  age       Int?
  gender    String?
  heightCm  Float?
  weightKg  Float?
  lifestyle String?
  /// Year of birth; age is derived at calculation time so it never goes stale.
  birthYear           Int?
  sexForCalculation   SexForCalculation?
  /// Standard adult equations do not apply; calculations are withheld when true.
  pregnantOrLactating Boolean?
  /// User-declared context (e.g. wheelchair user) under which step/activity equations may not apply.
  mobilityLimitation  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPreferences {
  userId             String     @id
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitSystem         UnitSystem @default(METRIC)
  timezone           String     @default("UTC")
  emailNotifications Boolean    @default(false)
  /// Days to keep uploaded images. Null = keep until the user deletes them.
  imageRetentionDays Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

/// Append-only. The latest row per (userId, type) is the current state.
model ConsentRecord {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          ConsentType
  granted       Boolean
  policyVersion String
  createdAt     DateTime    @default(now())

  @@index([userId, type, createdAt])
}

// ───────────────────────────── Storage ─────────────────────────────

model UploadedAsset {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     StorageProvider @default(CLOUDINARY)
  /// Provider object key (Cloudinary public_id). Never derived from client input.
  storageKey   String          @unique
  /// Cloudinary delivery type: "authenticated" for all Phase 1+ uploads.
  deliveryType String          @default("authenticated")
  purpose      AssetPurpose
  /// Verified from file signature, not from the browser.
  mimeType     String
  format       String
  sizeBytes    Int
  width        Int
  height       Int
  sha256       String
  status       AssetStatus     @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  /// Set when the stored file is removed. The row is kept so reports keep a consistent reference.
  deletedAt    DateTime?

  analyses        Analysis[]
  skinReports     SkinReport[]
  physicalReports PhysicalReport[]

  @@index([userId, createdAt])
  @@index([userId, sha256])
  @@index([status, createdAt])
}

// ───────────────────────────── Analysis lifecycle ─────────────────────────────

/// One analysis job. Exactly one domain report (or none, if FAILED) points back to it.
model Analysis {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain         WellnessDomain
  status         AnalysisStatus @default(QUEUED)
  /// Client-supplied key; duplicates for the same user return the original analysis.
  idempotencyKey String?
  /// BullMQ job id (equal to the analysis id for queued work; null for synchronous analyses).
  jobId          String?
  inputAssetId   String?
  inputAsset     UploadedAsset? @relation(fields: [inputAssetId], references: [id], onDelete: SetNull)
  /// Processing attempts so far ("retryCount" = attempts - 1).
  attempts       Int            @default(0)
  /// Failure code ("failureCode"); stable, machine-readable.
  errorCode      String?
  /// User-safe failure message ("failureMessage"). Never contains provider bodies or stack traces.
  errorMessage   String?
  /// Provenance: provider and model that produced the result, e.g. "saarthi-cv" / "skin-cv@3", "anthropic" / "claude-opus-5-5".
  modelProvider  String?
  modelId        String?
  modelVersion   String?
  /// Version of the prompt or rule set used (e.g. "synthesis-prompt@2", "questionnaire-rules@2").
  promptVersion  String?
  /// Non-identifying description of the input (asset dimensions/type, questionnaire schema version). No images, no free text.
  inputMetadata  Json?
  /// Non-identifying description of the run (duration, token usage, contract version).
  resultMetadata Json?
  queuedAt       DateTime       @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  input          AnalysisInput?
  result         AnalysisResult?
  skinReport     SkinReport?
  physicalReport PhysicalReport?
  mentalReport   MentalWellnessReport?
  combinedReport CombinedWellnessReport?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

/// Validated user input for an analysis (questionnaire answers). Separate table so it can be purged independently.
model AnalysisInput {
  analysisId    String   @id
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  schemaVersion Int      @default(1)
  questionnaire Json
  createdAt     DateTime @default(now())
}

/// Raw engine output kept for audit and reproducibility.
model AnalysisResult {
  analysisId    String   @id
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  engine        String
  engineVersion String
  rawOutput     Json
  durationMs    Int?
  inputTokens   Int?
  outputTokens  Int?
  /// Estimate from the configured price table (lib/ai/pricing.ts). Null when no price is configured.
  estimatedCostUsd Float?
  createdAt     DateTime @default(now())
}

// ───────────────────────────── Reports ─────────────────────────────

model SkinReport {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId      String?        @unique
  analysis        Analysis?      @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  assetId         String?
  asset           UploadedAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  method          ReportMethod
  engineVersion   String?
  skinScore       Int
  hydrationScore  Int?
  acneSeverity    Int?
  /// Null when the method does not produce a calibrated confidence.
  confidence      Float?
  metrics         Json?
  detectedIssues  Json
  recommendations Json
  summary         String
  /// Pre-Phase-1 public image URL. New reports reference `assetId` instead.
  imageUrl        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, createdAt])
}

model PhysicalReport {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId      String?        @unique
  analysis        Analysis?      @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  assetId         String?
  asset           UploadedAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  method          ReportMethod
  engineVersion   String?
  fitnessScore    Int
  postureScore    Int?
  mobilityScore   Int?
  balanceScore    Int?
  symmetryScore   Int?
  bmi             Float?
  sleepHours      Float?
  waterLiters     Float?
  workoutMinutes  Int?
  activityLevel   String?
  goal            String?
  confidence      Float?
  metrics         Json?
  detectedIssues  Json
  recommendations Json
  summary         String
  imageUrl        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, createdAt])
}

model MentalWellnessReport {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId      String?      @unique
  analysis        Analysis?    @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  method          ReportMethod
  engineVersion   String?
  wellnessScore   Int
  /// User-reported, 1-5.
  moodRating      Int?
  /// User-reported, 0-100.
  stressLevel     Int?
  /// User-reported, 1-5.
  energyRating    Int?
  sleepHours      Float?
  confidence      Float?
  metrics         Json?
  recommendations Json
  summary         String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, createdAt])
}

model CombinedWellnessReport {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId         String?      @unique
  analysis           Analysis?    @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  method             ReportMethod @default(LLM_SYNTHESIS)
  /// Arithmetic mean of the latest available domain scores. Never produced by the language model.
  overallHealthScore Int?
  aiInsights         String
  risks              Json
  actionPlan         Json
  /// Provider/model that wrote the narrative, e.g. "anthropic:claude-sonnet-5-5".
  model              String?
  /// { skin?: id, physical?: id, mental?: id } — the reports this synthesis used.
  sourceReportIds    Json?
  generatedAt        DateTime     @default(now())

  @@index([userId, generatedAt])
}

// ───────────────────────────── Tracking ─────────────────────────────

model ProgressHistory {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain         WellnessDomain
  metric         String         @default("score")
  value          Float
  /// Report that produced this point. Null for rows created before Phase 1.
  sourceReportId String?
  recordedAt     DateTime       @default(now())

  @@index([userId, domain, recordedAt])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stable code, e.g. "FIRST_SKIN_SCAN". Unique per user so concurrent jobs cannot award twice.
  code        String?
  title       String
  description String
  unlockedAt  DateTime @default(now())

  @@unique([userId, code])
  @@index([userId, unlockedAt])
}

model DailyHabit {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar day in the user's timezone. One self-reported log per day; every field is optional.
  date            DateTime @db.Date
  waterMl         Int?
  steps           Int?
  sleepHours      Float?
  /// Self-rated sleep quality, 1-5.
  sleepQuality    Int?
  exerciseMinutes Int?
  /// Self-rated, 1-5.
  moodRating      Int?
  /// Self-rated, 0-10.
  stressLevel     Int?
  /// Self-rated, 1-5.
  energyRating    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Encrypted at the application layer when FIELD_ENCRYPTION_KEY is configured ("enc:v1:..." prefix).
  content    String
  moodRating Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
}

model Recommendation {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain         WellnessDomain
  sourceReportId String?
  /// What to do.
  text           String
  /// Stable rule identifier, e.g. "sleep.below_7h". Unique per user while ACTIVE (dedupe on regeneration).
  ruleId         String?
  engineVersion  String?
  /// Why it is recommended.
  rationale      String?
  /// Which of the user's data supports it: [{ source, field, value, unit, recordedAt }].
  evidence       Json?
  /// Expected measurable behaviour, e.g. "Log ≥7 h sleep on 5 of the next 7 nights".
  measurableTarget String?
  frequency      String?
  limitations    Json?
  priority       Int                  @default(0)
  status         RecommendationStatus @default(ACTIVE)
  completedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId, status, createdAt])
  @@index([userId, ruleId])
}

/// A user-defined target for one tracked metric.
model WellnessGoal {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      WellnessDomain
  /// Metric key from the metric registry (features/metrics/registry.ts), e.g. "habit.sleepHours".
  metric      String
  /// "at_least" | "at_most"
  direction   String
  targetValue Float
  unit        String
  startDate   DateTime       @db.Date
  targetDate  DateTime?      @db.Date
  status      GoalStatus     @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, status])
}

/// One call to an AI provider: latency, token usage and estimated cost. Contains no prompt or response text.
model AiUsageEvent {
  id               String    @id @default(cuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature          AiFeature
  provider         String
  model            String
  promptVersion    String?
  success          Boolean
  errorCode        String?
  latencyMs        Int
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  /// Set when a fallback provider served the request.
  fallbackFrom     String?
  createdAt        DateTime  @default(now())

  @@index([feature, createdAt])
  @@index([userId, createdAt])
}

// ───────────────────────────── AI companion ─────────────────────────────

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String                       @id @default(cuid())
  conversationId String
  conversation   AIConversation               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  /// Encrypted at the application layer when FIELD_ENCRYPTION_KEY is configured.
  content        String
  /// Assistant messages: "provider:model" that produced it.
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  /// Safety handling applied to this turn, e.g. { crisisResourcesShown: true }. Never contains message text.
  safety         Json?
  /// pgvector embedding for retrieval (Phase 3).
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())

  @@index([conversationId, createdAt])
}

// ───────────────────────────── Platform ─────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Security-relevant events. Survives account deletion with the actor reference cleared.
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  resourceType String?
  resourceId   String?
  requestId    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
