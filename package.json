{
  "name": "saarthi",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:baseline": "prisma migrate resolve --applied 20261113000000_baseline",
    "worker": "tsx workers/analysis/index.ts",
    "worker:dev": "tsx watch workers/analysis/index.ts",
    "queue:admin": "tsx scripts/queue-admin.ts",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "ai:dev": "cd ai-service && python -m uvicorn app.main:app --reload --port 8000",
    "ai:test": "docker build --target test -t saarthi-ai-service-test ai-service",
    "deps:check": "npm outdated || true && npm audit --omit=dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@clerk/nextjs": "^7.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.77.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^18.0.10",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
