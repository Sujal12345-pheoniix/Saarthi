# ─────────────────────────────────────────────────────────────────────────────
# Saarthi web app + worker configuration.
# Copy to `.env` in the PROJECT ROOT (Next.js does not read .env files in sub-folders).
# Full reference: docs/deployment/ENVIRONMENT_CONFIGURATION.md
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production   (staging/production enable strict validation)
APP_ENV=development
# Public origin of the web app (required in staging/production; used for CSRF origin checks)
APP_URL=http://localhost:3000
# Extra origins allowed to make state-changing requests (comma-separated, optional)
ALLOWED_ORIGINS=
LOG_LEVEL=info

# ── Database (PostgreSQL with the pgvector extension) ──
DATABASE_URL=postgresql://saarthi:saarthi@localhost:5432/saarthi

# ── Authentication (Clerk) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Local-only auth bypass. Refused at startup unless NODE_ENV=development AND APP_ENV=development.
DEV_ALLOW_ANON=false

# ── Queue (Redis + BullMQ) ──
REDIS_URL=redis://localhost:6379
# Legacy alternative (used only if REDIS_URL is empty):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# queue  = background worker processes analyses (run `npm run worker`)
# inline = analyses run inside the HTTP request (for hosts without a worker; long requests)
ANALYSIS_EXECUTION_MODE=queue
WORKER_CONCURRENCY=2
RATE_LIMIT_ENABLED=true

# ── Image storage (Cloudinary; images are stored as private "authenticated" assets) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Hosts the worker may download stored images from (comma-separated)
STORAGE_ALLOWED_HOSTS=res.cloudinary.com,api.cloudinary.com

# ── Computer-vision service (ai-service/) ──
AI_SERVICE_URL=http://localhost:8000
# Shared secret, >= 32 characters, identical in the web app, the worker and ai-service.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=60000

# ── Language model for combined reports ──
# anthropic | gemini | openai_compatible | none   (inferred from the single key present when unset)
LLM_PROVIDER=anthropic
LLM_TIMEOUT_MS=120000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# ── Integration tests only (database name must contain "test"; it is wiped) ──
TEST_DATABASE_URL=postgresql://saarthi:saarthi@localhost:5432/saarthi_test
TEST_REDIS_URL=redis://localhost:6379/1
